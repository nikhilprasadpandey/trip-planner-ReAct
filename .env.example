# Copy to .env and fill in. Nothing here is a real secret.

# --- LLM ---
OPENAI_API_KEY=

# --- Vector DB (Qdrant Cloud, policy corpus) ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=corporate-travel-policy

# --- Embeddings (policy corpus ingestion + retrieval; see rag/embeddings.py) ---
# Same OPENAI_API_KEY as the LLM above — one provider, one key.
EMBEDDING_MODEL=text-embedding-3-small

# --- Flight pricing providers (provider-swappable; see config/flight_provider.yaml) ---
FLIGHT_PROVIDER=duffel          # duffel (test mode, dev/rehearsal) | aviationstack (live, demo)
AVIATIONSTACK_API_KEY=
DUFFEL_ACCESS_TOKEN=

# --- Weather / geocoding (free, no key required: Nominatim + Open-Meteo) ---
# Optional overrides — leave blank to use the public instances. Set these to
# a self-hosted Nominatim / the paid Open-Meteo tier for production, where
# the public Nominatim usage policy (light use only) doesn't fit.
NOMINATIM_URL=
OPEN_METEO_URL=

# --- Observability (optional — app no-ops Langfuse tracing if unset) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Route cache (cache/route_cache.py) ---
# Optional — falls back to an in-process cache when unset.
REDIS_URL=

# --- Audit store ---
AUDIT_DB_URL=sqlite:///./data/audit.db   # prod: postgresql+psycopg://user:pass@host:5432/dbname — no code change

# --- Auth (mock OIDC/RBAC for local dev/demo; see src/trip_planner/api/auth.py) ---
MOCK_AUTH_ENABLED=true

# --- App ---
API_GATEWAY_URL=http://localhost:8000
LOG_LEVEL=INFO
